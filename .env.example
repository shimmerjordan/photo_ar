# cp .env.example .env 然后填。docker compose 会自动读同目录的 .env。
# .env 已被 .gitignore 排除 —— token 与口令不要进版本库。
#
# **只有 PHOTOAR_ROOTS 需要你真的看一眼**，其余都有能用的默认值。填完：
#   docker compose up -d && docker compose logs -f photo-ar-server
# 日志里会打印一次随机管理员口令，抄走它登录 http://<NAS>:8964/admin。


# ============ 必须看一眼 ============

# 白名单根目录。服务只允许访问这些目录以下的文件。
#
# 路径是**容器内**的路径，要与 docker-compose.yml 里 volumes 的右半边一致
# （那份文件里冒号两边写成一样，就是为了不用换算）。名字随意，会显示在 App 的
# 目录浏览器里；也可以只写路径列表（`/share/Photo,/share/Video`），那时自动
# 拿目录名当名字。
#
# ⚠️ 请用 `/share/Photo` 这一层，**不要用 `ls -l` 出来的
# `/share/CACHEDEV1_DATA/Photo`** —— 前者是符号链接，两者混用会 403。
PHOTOAR_ROOTS=照片=/share/Photo,视频=/share/Video,网盘=/share/CloudDrive


# ============ 身份 ============

# 运维凭证，给**机器**用：tools/batch_ingest.py。生成：openssl rand -hex 24
#
# **可以留空。** 人走 /admin 各自一个账号登录，鉴权不依赖这个 token；留空时
# 服务里那条 legacy 凭证分支会被**整体禁用**（不是"谁都能通过"）。留空的唯一代价是
# 批量入库脚本没法用，而且容器健康检查只能确认"服务活着"（401 也算通过）而不能确认
# "凭证是对的"。
#
# 它**登不出**（没有服务端状态可删，作废只能改这里再重启），所以不该发给家里人。
PHOTOAR_TOKEN=

# 引导管理员。库里一个 admin 都没有时（= 第一次启动）按这两个值建一个。
#
# 口令留空也能跑：服务会生成一个随机口令并**在启动日志里打印一次**
# （`docker compose logs photo-ar-server | grep 随机口令`），登进去之后立刻改掉。
# 想要一个自己记得住的就填在这里。名字留空默认 admin。
#
# 开发机（deploy/compose.local.yml）也从这个文件取，刻意不写死在那份 compose 里 ——
# 这个仓库是公开的，而固定口令印在源码里等于没有口令（理由见 app.py 的
# `_bootstrap_admin`）。所以 .env 在 .gitignore 里，这份 .env.example 里也只留空值。
# PHOTOAR_ADMIN_NAME=admin
PHOTOAR_ADMIN_PASSWORD=

# 会话 cookie 要不要带 Secure。默认 0（关）。
#
# 只在**所有**访问都走 https 时才设 1。compose 里那条 ports 是 LAN 直连（http），
# 开了 Secure 浏览器会直接丢掉 cookie —— 表现是"登录成功了但一刷新又要登录"，
# 而响应里确实有 Set-Cookie，几乎不可能往 cookie 属性上想。
# PHOTOAR_COOKIE_SECURE=0


# ============ 识别后端 ============

# orb（默认）或 xfeat。
#
# orb 是通过出口条件的基线（真实语料上命中 95.70%、真实误识别 0.000%、P95 67.7ms），
# 纯 CPU、不需要任何模型文件。xfeat 是 64 维浮点描述子 + ONNX 推理，在纸质翻拍上
# 预期更强但更慢，而且需要 xfeat.onnx（见下面）。
#
# ⚠️ 这个变量只作为**初始值**写进库，一次。之后以管理台里那个下拉框为准 ——
# 否则你在管理台改完、重启一次容器就被这里改回去了。
# ⚠️ 换后端 = 全库描述子作废（两种描述子格式不兼容）。两个后端各有自己的库目录
# （data/library 与 data/library_xfeat），所以换回来不会丢东西，但新后端那边是空的，
# 要重新入库。
# PHOTOAR_BACKEND=orb

# xfeat.onnx 从哪儿下。留空 = 用本项目 GitHub release 上的默认地址。
#
# ⚠️ **那个 release 目前还没发布**，所以默认会 404。这不影响启动：服务会回退 orb，
# `GET /v1/ping` 的 `backendDegraded: true` 与 `backendError` 会说明原因。
#
# 真要用 xfeat，三条路：
#   1) 自己导出（最可靠，服务端与 App 用的是同一份产物）：
#        pip install -e ".[export]" && python tools/export_models.py --out ./data/models
#   2) 把导出好的 xfeat.onnx 发到本项目的 GitHub release（tag models-v1）；
#   3) 已经有一份可信的（sha256 见 tools/fetch_models.py 里的 EXPECTED_SHA256）
#      挂在别处，填在这里。
# PHOTOAR_MODEL_URL=

# 设 0 = 启动时完全不尝试下载模型。离线部署、或者模型已经手工放进 ./data/models 时用。
# PHOTOAR_FETCH_MODELS=1


# ============ 转码 ============

# auto（默认）探测到核显就用 h264_vaapi，探测不到**静默**回退 libx264。
# 软编在 N5095 上慢一个量级（一条 30 秒视频约 56 秒 vs 几秒），慢到会撞上
# Cloudflare 隧道的 125 秒超时。所以确认硬编生效之后就改成 h264_vaapi ——
# 那样核显哪天不可用（QTS 升级、设备号变了）会**直接报错**而不是悄悄软编，
# 后者唯一的发现方式是掐表。确认方法见 docs/deploy.md 第 4 步。
# PHOTOAR_VIDEO_ENCODER=auto


# ============ 其它 ============

# 宿主机上映射出来的端口。改它不影响容器内（容器内固定 8964）。
# PHOTOAR_PORT=8964

# /v1/upload 的落地目录。必须在 PHOTOAR_ROOTS 之内，且 compose 里那条挂载要可写。
# 留空 = 上传功能整体关闭（503）。正常用法是关联 NAS 上已有的文件。
# PHOTOAR_UPLOAD_DIR=/share/Photo/_arphoto_inbox

# 镜像。默认是 GHCR 上的 latest；填具体 tag 可以钉住版本或回滚，例如
#   ghcr.io/shimmerjordan/photo-ar-server:sha-1a2b3c4
# 想跑本地构建的镜像就填 photo-ar-server:dev，并用 docker compose build 构建。
# PHOTOAR_IMAGE=ghcr.io/shimmerjordan/photo-ar-server:latest
