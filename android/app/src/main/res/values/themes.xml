<?xml version="1.0" encoding="utf-8"?>
<!--
  外壳的主题。在这之前 manifest 里直接写 @android:style/Theme.Material.NoActionBar，
  于是有两个坑：

   1. 底部那条系统手势条的背景由 framework 的 navigationBarColor 决定，而 MIUI 把它
      改成了**白色** —— 深色界面下面吊一条 16dp 的纯白，实测 y=2355..2399 是
      #FFFFFF，上面才是导航栏自己的 #211F26。这里连同状态栏一起设成透明，让
      NavigationBar 的背景自己铺到屏幕最底（配合 MainActivity 里的 enableEdgeToEdge）。
   2. windowBackground 是 Theme.Material 的 #303030，比我们的 surface(#121316) 亮一档，
      冷启动那一两帧会先闪一下这个灰。

  windowLightNavigationBar / windowLightStatusBar 是 API 27 起才有的属性，minSdk 24
  的老机器会忽略未知属性（aapt 只警告不报错），行为退化成「系统自己决定图标颜色」，
  可以接受；真正兜底的是 MainActivity 里 SystemBarStyle.dark 那两行，它有版本分支。
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PhotoAr" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF121316</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 系统栏图标用浅色：这个 App 固定深色，不跟随系统的浅色模式。 -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
